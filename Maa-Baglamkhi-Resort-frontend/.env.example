# Base URL for every API call.
#   /api                  -> same-origin; Vite dev proxy on 5173 forwards to 5002. Use this.
#   http://host:5002/api  -> only when the frontend is served from another origin and you
#                            want cross-origin requests (needs CORS_ORIGINS set on the backend).
VITE_API_BASE_URL=/api

# Backend origin (no path). Used for the socket.io client and direct upload URLs.
VITE_BACKEND_ORIGIN=http://localhost:5002

# Optional: contact number shown for admin WhatsApp notifications.
VITE_ADMIN_WHATSAPP_NUMBER=
