{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",

    "baseUrl": "",
    "paths": {
      "@/*": ["src/*"]
    },

    "jsx": "react-jsx",
    "module": "esnext", 
    
    "target": "es2020",
    "checkJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}