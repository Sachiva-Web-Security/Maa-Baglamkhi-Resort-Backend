# =============================================
# Maa Bhaglamkhi Resort - Backend Config
# Local Network Deployment
# =============================================

# Database (change DB_PASSWORD to your MySQL password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=employee3
DB_CONNECTION_LIMIT=10

# Server
PORT=5002

# Keep this as "development" for local network deploy
# so CORS auto-allows 192.168.x.x private IPs
NODE_ENV=development

# JWT - CHANGE THIS to a long random string in production!
JWT_SECRET=resort_jwt_secret_2026_make_it_long_random
JWT_EXPIRES_IN=7d

# CORS - add your server's WiFi IP here
# Example: http://192.168.1.100:3000
# You can add multiple IPs: http://192.168.1.100:3000,http://192.168.1.101:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Security
ALLOW_REGISTER=false
SKIP_PAYMENT_SCHEMA_BOOTSTRAP=false
PAYMENTS_TABLE_NAME=payments

# WhatsApp (optional - for sending invoices via WhatsApp)
WASEND_USERNAME=anju
WASEND_TOKEN=YOUR_DEVICE_TOKEN
