PORT=5002
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=employee3
DB_NAME_TEST=hotel_management_test
DB_CONNECTION_LIMIT=10
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Origins allowed to call this API directly (bypassing the Vite proxy).
# This list REPLACES the built-in dev list; it never stacks with the
# localhost / private-LAN auto-allow, which only applies while this value is
# empty. Name every origin you expect to reach this port.
# Set CORS_ALLOW_LOCAL=true to keep the localhost / 192.168 / 10 / 172 LAN
# auto-allow in force even when this list is populated.
# Normal browser traffic goes through the Vite proxy and stays same-origin.
CORS_ORIGINS=
CORS_ALLOW_LOCAL=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
ALLOW_REGISTER=false
SKIP_PAYMENT_SCHEMA_BOOTSTRAP=false
PAYMENTS_TABLE_NAME=payments

# ============================================================
# PRINT SYSTEM CONFIGURATION
# ============================================================
AUTO_PRINT_ENABLED=true
PRINT_A4_PRINTER_NAME="HP Smart Tank 580 Series"
PRINT_A4_PRINTER_ENABLED=true
PRINT_THERMAL_PRINTER_NAME="RP326 ESC/POS Thermal Receipt Printer"
PRINT_THERMAL_PRINTER_ENABLED=true
PRINT_QUEUE_POLL_INTERVAL_MS=2000
PRINT_MAX_RETRIES=3
PRINT_RETRY_DELAY_MS=5000
INVOICE_UPLOAD_DIR=./backend/uploads/invoices
THERMAL_UPLOAD_DIR=./backend/uploads/thermal
